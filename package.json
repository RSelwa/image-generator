{
  "name": "geo-gamer",
  "version": "1.0.0",
  "description": "Monorepo for flim",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "scripts": {
    "compile": "turbo compile --continue",
    "lint": "NODE_OPTIONS=--disable-warning=MODULE_TYPELESS_PACKAGE_JSON oxlint",
    "lint:errors": "NODE_OPTIONS=--disable-warning=MODULE_TYPELESS_PACKAGE_JSON oxlint --quiet",
    "lint:fix": "NODE_OPTIONS=--disable-warning=MODULE_TYPELESS_PACKAGE_JSON oxlint --fix",
    "lint:ci": "turbo run build --filter='./libs/*' && NODE_OPTIONS=--disable-warning=MODULE_TYPELESS_PACKAGE_JSON oxlint",
    "format": "NODE_OPTIONS=--disable-warning=MODULE_TYPELESS_PACKAGE_JSON oxfmt",
    "format:check": "NODE_OPTIONS=--disable-warning=MODULE_TYPELESS_PACKAGE_JSON oxfmt --check",
    "check-circular": "turbo check-circular --continue",
    "emulators:test": "firebase emulators:start --only firestore,functions,storage,auth,database",
    "test:front-ui": "pnpm -F @repo/front e2e:ui",
    "build:front": "turbo run -F @repo/front build",
    "dev:front": "turbo run -F @repo/front dev",
    "storybook:front": "pnpm run -F @repo/front storybook",
    "build": "turbo run build",
    "create:function": "npx tsx cli/create-function.mts",
    "build:libs": "turbo run build --filter=@repo/providers --filter=@repo/schemas --filter=@repo/testing --filter=@repo/common && pnpm install",
    "build:cf": "turbo run build --filter='./functions/*'",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "dev:server": "deno run --allow-all --env=./scripts/.env --config scripts/deno.json scripts/src/server/index.ts",
    "test": "turbo run test",
    "watch": "turbo watch build --filter=@repo/providers --filter='./functions/*'",
    "deploy": "firebase deploy",
    "script": "deno run --allow-all --env=./scripts/.env --config scripts/deno.json"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/node": "^26.5.1",
    "consola": "^3.4.2",
    "firebase-tools-with-isolate": "15.30.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.30.0"
}
