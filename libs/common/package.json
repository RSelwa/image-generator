{
  "name": "@repo/common",
  "type": "module",
  "version": "0.0.0",
  "description": "Common code for both backend and frontend",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "compile": "tsc --noEmit",
    "lint": "biome check",
    "check-circular": "madge --circular --extensions ts ./src --ts-config ./tsconfig.json",
    "test": "vitest run --coverage",
    "clean": "del-cli dist isolate tsconfig.tsbuildinfo",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0"
  },
  "devDependencies": {
    "@codecompose/typescript-config": "^5.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "del-cli": "^7.0.0",
    "madge": "^8.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
