{
  "name": "@repo/testing",
  "type": "module",
  "version": "1.0.0",
  "description": "Testing utilities for the monorepo",
  "license": "MIT",
  "exports": {
    "./factory": {
      "types": "./dist/factory.d.ts",
      "default": "./dist/factory.js"
    },
    "./orm": {
      "types": "./dist/orm.d.ts",
      "default": "./dist/orm.js"
    },
    "./emulator": {
      "types": "./dist/emulator.d.ts",
      "default": "./dist/emulator.js"
    },
    "./document-snapshot": {
      "types": "./dist/document-snapshot.d.ts",
      "default": "./dist/document-snapshot.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "compile": "tsc --noEmit",
    "lint": "biome check",
    "check-circular": "madge --circular --extensions ts ./src --ts-config ./tsconfig.json",
    "test": "vitest run --coverage",
    "clean": "del-cli dist isolate tsconfig.tsbuildinfo",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@firebase/firestore": "^4.17.2",
    "@repo/common": "workspace:*",
    "@repo/providers": "workspace:*",
    "@repo/schemas": "workspace:*",
    "firebase-admin": "^14.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codecompose/typescript-config": "^5.1.0",
    "@faker-js/faker": "^10.6.0",
    "@vitest/coverage-v8": "^5.0.0",
    "del-cli": "^7.0.0",
    "firebase": "^12.19.0",
    "madge": "^8.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
