{
  "name": "@repo/providers",
  "version": "0.0.0",
  "description": "Providers of services for the monorepo",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./db-refs": {
      "types": "./dist/db-refs.js",
      "default": "./dist/db-refs.js"
    },
    "./firebase": {
      "types": "./dist/firebase.js",
      "default": "./dist/firebase.js"
    },
    "./upload-post": {
      "types": "./dist/upload-post.js",
      "default": "./dist/upload-post.js"
    }
  },
  "scripts": {
    "compile": "tsc --noEmit",
    "check-circular": "madge --circular --extensions ts ./src --ts-config ./tsconfig.json",
    "build": "tsdown",
    "coverage": "vitest run --coverage",
    "clean": "del-cli dist isolate tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^3.6.0",
    "@repo/common": "workspace:*",
    "@repo/schemas": "workspace:*",
    "dotenv": "^17.4.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "upload-post": "^2.14.0"
  },
  "devDependencies": {
    "@codecompose/typescript-config": "^5.1.0",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "del-cli": "^7.0.0",
    "madge": "^8.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
