{
  "name": "@repo/http",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    ".env.*",
    "dist"
  ],
  "scripts": {
    "compile": "tsc --noEmit",
    "lint": "biome check",
    "check-circular": "madge --circular --extensions ts ./src --ts-config ./tsconfig.json",
    "test": "vitest run --coverage",
    "build": "tsdown",
    "clean": "del-cli dist isolate tsconfig.tsbuildinfo coverage",
    "test:coverage": "vitest run --coverage",
    "deploy": "firebase deploy --project tiktok-generator-fa261",
    "emulate": "firebase emulators:start --project tiktok-generator-fa261",
    "login": "firebase login",
    "env": "ls env.txt && grep -Ev '^#' env.txt  | xargs --no-run-if-empty -I NAME sh -c 'echo NAME=\"$(firebase functions:secrets:access \"$1\")\" >> .env.local' _ NAME || echo \"Please provide an env.txt\""
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "@repo/common": "workspace:*",
    "@repo/providers": "workspace:*",
    "cors": "^2.8.6",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "nocache": "^4.0.0"
  },
  "devDependencies": {
    "@codecompose/typescript-config": "^5.1.0",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "del-cli": "^7.0.0",
    "firebase-functions-test": "^3.5.0",
    "madge": "^8.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
